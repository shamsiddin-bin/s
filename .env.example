# Local: npm run setup creates INITIAL_ADMIN_HASH safely.
INITIAL_ADMIN_HASH=
# Render: choose your own strong password (12+ characters) in Environment.
# Used only for first initialization. Later change it in /admin.
ADMIN_PASSWORD=
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# Production HTTPS URL; Render automatically supplies RENDER_EXTERNAL_URL.
# APP_URL=https://your-domain.example
# 0: direct local connection. 1: exactly one trusted reverse proxy (Render).
TRUST_PROXY_HOPS=0
